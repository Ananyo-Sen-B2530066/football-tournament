<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE — do not install this file directly.

  `hub install` (scripts/hub.sh) copies this to
  ~/Library/LaunchAgents/com.efootball.techfest-hub.plist, substituting the
  __PROJECT_DIR__ / __NODE_BIN__ / __NEXT_BIN__ placeholders with real absolute
  paths. It is a template so that no machine-specific file is committed.

  Why absolute paths instead of bare `npm start`:
    launchd agents run outside your login shell with a minimal PATH, so `npm`
    and `npx` are often not resolvable. Invoking the `next` binary through the
    absolute node path removes that whole class of failure.

  __PROJECT_DIR__ is REQUIRED, not cosmetic: STATE_FILE ("data/state.json")
  and the config-staleness check ("config/tournament.config.ts") are both
  resolved relative to process.cwd(). A wrong WorkingDirectory makes the server
  write state to the wrong place.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.efootball.techfest-hub</string>

    <key>ProgramArguments</key>
    <array>
        <!-- caffeinate keeps the host awake: a sleeping Mac kills the show for
             every phone and the projector. -d display, -i idle, -m disk, -s
             only on AC, -u declares the user as "using" the power. -->
        <string>/usr/bin/caffeinate</string>
        <string>-dimsu</string>
        <string>__NODE_BIN__</string>
        <string>__NEXT_BIN__</string>
        <string>start</string>
        <string>-H</string>
        <string>0.0.0.0</string>
        <string>-p</string>
        <string>8000</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>NODE_ENV</key>
        <string>production</string>
    </dict>

    <!-- Start on login, so the hub is already up before anyone arrives. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart if it ever dies. ThrottleInterval stops a broken build from
         becoming a tight crash loop. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Be a good neighbour: yield CPU to the apps you are actually using. -->
    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/server.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/server.err.log</string>
</dict>
</plist>
